{
  "manifest_version": 3,
  "name": "百应选品助手",
  "version": "1.0.0",
  "description": "自动提取百应选品广场产品信息：品名、佣金百分比、佣金赚",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://buyin.jinritemai.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://buyin.jinritemai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
